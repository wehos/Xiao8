        ],
        "type": "object"
      },
      "metadata": {},
      "model_validate": true,
      "name": "读取主动搭话状态",
      "return_message": "",
      "timeout": null
    },
    {
      "auto_start": false,
      "description": "套用一组主动搭话预设。可选模式：'off'（全关，默认首次启动值）、'normal'（推荐配置，所有源开启，间隔 15s/10s）、'focus'（低打扰，仅留搭话和个人动态，间隔 60s）、'frequent'（高频，全开，间隔 5s）。 注意：预设不会改变 proactiveVisionEnabled（隐私模式）—— 那是用户绝对控制权。",
      "event_key": "proactive_controller.set_mode",
      "event_type": "plugin_entry",
      "id": "set_mode",
      "input_schema": {
        "properties": {
          "mode": {
            "description": "目标模式名称",
            "enum": [
              "off",
              "normal",
              "focus",
              "frequent"
            ],
            "type": "string"
          }
        },
        "required": [
          "mode"
        ],
        "type": "object"
      },
      "kind": "action",
      "llm_result_fields": [
        "mode"
      ],
      "llm_result_schema": {
        "properties": {
          "mode": {}
        },
        "required": [
          "mode"
        ],
        "type": "object"
      },
      "metadata": {},
      "model_validate": true,
      "name": "切换主动搭话模式",
      "return_message": "",
      "timeout": null
    },
    {
      "auto_start": false,
      "description": "对主动搭话字段做部分更新。仅接受白名单内字段，未识别字段会被忽略。字段：proactive*Enabled（布尔），proactiveChatInterval/proactiveVisionInterval（秒，1~3600）。 注意：proactiveVisionEnabled（隐私模式）是用户绝对控制权，插件不能调整；试图传入会被拒绝。",
      "event_key": "proactive_controller.set_settings",
      "event_type": "plugin_entry",
      "id": "set_settings",
      "input_schema": {
        "properties": {
          "settings": {
            "description": "要更新的字段映射；键名必须命中白名单（不含 proactiveVisionEnabled 隐私模式）。",
            "type": "object"
          }
        },
        "required": [
          "settings"
        ],
        "type": "object"
      },
      "kind": "action",
      "llm_result_fields": [],
      "llm_result_schema": {},
      "metadata": {},
      "model_validate": true,
      "name": "细粒度调整主动搭话",
      "return_message": "",
      "timeout": null
    }
  ],
