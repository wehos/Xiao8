    {
      "auto_start": false,
      "description": "聚合入口：根据 action 路由到 set_mode / set_settings / get_state，方便其他插件通过单一调用控制主动搭话。",
      "event_key": "proactive_controller.command",
      "event_type": "plugin_entry",
      "id": "command",
      "input_schema": {
        "properties": {
          "action": {
            "description": "要执行的操作",
            "enum": [
              "set_mode",
              "set_settings",
              "get_state"
            ],
            "type": "string"
          },
          "mode": {
            "description": "action=set_mode 时的目标模式",
            "type": "string"
          },
          "settings": {
            "description": "action=set_settings 时的字段映射",
            "type": "object"
          }
        },
        "required": [
          "action"
        ],
        "type": "object"
      },
      "kind": "action",
      "llm_result_fields": [],
      "llm_result_schema": {},
      "metadata": {},
      "model_validate": true,
      "name": "主动搭话统一指令通道",
      "return_message": "",
      "timeout": null
    },
    {
      "auto_start": false,
      "description": "返回当前模式（off/normal/focus/frequent/custom）以及主动搭话字段当前值。",
      "event_key": "proactive_controller.get_state",
      "event_type": "plugin_entry",
      "id": "get_state",
      "input_schema": {
        "properties": {},
        "type": "object"
      },
      "kind": "action",
